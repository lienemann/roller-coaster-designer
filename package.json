{
  "name": "roller-coaster-designer",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based force-vector roller coaster design tool.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roller-coaster-designer/app dev",
    "build:libs": "tsc -b tsconfig.json",
    "build:app": "pnpm --filter @roller-coaster-designer/app build",
    "build": "pnpm build:libs && pnpm build:app",
    "clean": "pnpm -r clean && rm -rf **/*.tsbuildinfo",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm build:libs && pnpm --filter @roller-coaster-designer/app typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,html,css}\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:app"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.14.12",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
