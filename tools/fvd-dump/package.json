{
  "name": "@roller-coaster-designer/fvd-dump",
  "version": "0.0.0",
  "description": "CLI: read a legacy .fvd file and emit its node stream as JSON or CSV. Used to generate golden reference data from FVD++ outputs.",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "bin": {
    "fvd-dump": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roller-coaster-designer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
